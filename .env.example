# Google Cloud
PROJECT_ID=your-gcp-project
REGION=europe-west1
PUBSUB_TOPIC=deploy-failures
PUBSUB_SUBSCRIPTION=deploy-failures-agent

# Vertex AI / Gemini
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# Firestore
FIRESTORE_DATABASE=(default)

# GKE (Phase 3 — Connect Gateway)
GKE_MEMBERSHIP=deployguard-cluster
GKE_LOCATION=europe-west1

# Slack (stored in Secret Manager in prod; here for local dev only)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL=#deployguard

# Behavior
OOM_BUMP_FACTOR=1.5
APPROVAL_TTL_MINUTES=30
